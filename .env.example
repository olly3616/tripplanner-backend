# Copy to `.env` for local runs and adjust as needed.
# `.env` itself is git-ignored — never commit real secrets.

# Active Spring profile: local | dev | prod
SPRING_PROFILES_ACTIVE=local

# MySQL connection (local profile has sensible defaults if omitted)
DB_URL=jdbc:mysql://localhost:3306/voyage?serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true
DB_USERNAME=voyage
DB_PASSWORD=voyage

# Server
SERVER_PORT=8080

# JWT (HS256 secret must be >= 32 bytes; local profile has a dev default)
JWT_SECRET=local-dev-secret-change-me-0123456789-abcdef-0123
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Refresh-token store: db (default) or redis
# VOYAGE_AUTH_TOKEN_STORE=db
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379

# Google login (set the OAuth client id to enable POST /api/auth/google)
# VOYAGE_AUTH_GOOGLE_CLIENT_ID=

# Object storage: local (default) or s3
# VOYAGE_STORAGE_TYPE=local
# VOYAGE_STORAGE_S3_BUCKET=
# VOYAGE_STORAGE_S3_REGION=ap-northeast-2
